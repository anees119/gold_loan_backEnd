# Flask
FLASK_APP=run.py
FLASK_DEBUG=0

# Application security
SECRET_KEY=replace-with-generated-secret-key
JWT_SECRET_KEY=replace-with-generated-jwt-secret

# Aiven MySQL connection
DB_HOST=your-aiven-mysql-host
DB_PORT=your-aiven-mysql-port
DB_NAME=your-database-name
DB_USER=your-aiven-username
DB_PASSWORD=your-aiven-password

# Field encryption
FIELD_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Frontend CORS origins
CORS_ORIGINS=http://localhost:3000

# Aiven CA certificate path
DB_SSL_CA=certs/ca.pem
